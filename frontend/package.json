{
  "name": "et3am-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-git-info.cjs && vite",
    "dev:staging": "node scripts/generate-git-info.cjs && vite --mode staging",
    "dev:test": "node scripts/generate-git-info.cjs && vite --mode test",
    "build": "node scripts/generate-git-info.cjs && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && vite build",
    "build:staging": "node scripts/generate-git-info.cjs && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && vite build --mode staging",
    "build:test": "node scripts/generate-git-info.cjs && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && vite build --mode test",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "preview:test": "vite preview --mode test",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && firebase deploy --only hosting --project foodshare777",
    "deploy:staging": "npm run build:staging && firebase deploy --only hosting --project foodshare777-staging",
    "deploy:test": "npm run build:test && firebase deploy --only hosting --project foodshare777-test",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "electron:start": "electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.et3am.app",
    "productName": "ET3AM",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/et3am-og.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/et3am-og.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/et3am-og.png"
    }
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "chart.js": "^4.4.1",
    "firebase": "^10.8.0",
    "i18next": "^23.7.16",
    "i18next-browser-languagedetector": "^7.2.0",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^6.21.1",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/react": "^14.1.2",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.5.0",
    "jsdom": "^23.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
